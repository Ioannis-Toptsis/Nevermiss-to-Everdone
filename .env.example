# Next.js / runtime
# Usually set automatically by npm scripts, Next.js, or your hosting platform.
# NODE_ENV=development

# Public app URL used for OAuth callback generation in proxied/production setups.
APP_URL=https://example.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public external links
NEXT_PUBLIC_BUILD_GUIDE_URL=
NEXT_PUBLIC_MAP_URL=
NEXT_PUBLIC_WIKI_URL=

# Optional custom background video
NEXT_PUBLIC_BACKGROUND_VIDEO_URL=
